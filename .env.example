# AEGIS-Recon Environment Variables
# Copy this file to .env and fill in values for your environment.
# Never commit .env to version control.

# ── API Settings ──────────────────────────────────────────────────────────────

# API host and port (default: 127.0.0.1:8000)
API_HOST=127.0.0.1
API_PORT=8000

# API key for protected endpoints (leave blank to disable auth in dev)
# In production, set a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────

# Path to the SQLite database file
DATABASE_PATH=data/aegis.db

# ── NVD API ───────────────────────────────────────────────────────────────────

# NVD API key (optional but recommended to avoid rate limits)
# Register at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Cache TTL for NVD responses in seconds (default: 86400 = 24 hours)
NVD_CACHE_TTL=86400

# ── CISA KEV ─────────────────────────────────────────────────────────────────

# Cache TTL for KEV data in seconds (default: 86400 = 24 hours)
KEV_CACHE_TTL=86400

# ── EPSS ──────────────────────────────────────────────────────────────────────

# EPSS cache TTL in seconds (default: 86400 = 24 hours)
EPSS_CACHE_TTL=86400

# ── AI / Gemini ───────────────────────────────────────────────────────────────

# Google Gemini API key (optional; AI features disabled if not set)
# Register at: https://aistudio.google.com/
GEMINI_API_KEY=

# AI model to use (default: gemini-1.5-flash)
AI_MODEL=gemini-1.5-flash

# ── Logging ───────────────────────────────────────────────────────────────────

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ── Risk Policy ───────────────────────────────────────────────────────────────

# Path to risk policy YAML (default: configs/risk_policy.yaml)
RISK_POLICY_PATH=configs/risk_policy.yaml
