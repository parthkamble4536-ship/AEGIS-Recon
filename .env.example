# AEGIS-Recon Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── General ──────────────────────────────────────────────
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# ── Nmap ─────────────────────────────────────────────────
NMAP_PATH=nmap
# Full path to nmap binary if not on PATH (e.g., /usr/bin/nmap)
NMAP_TIMEOUT=300
# Maximum seconds for a single scan before timeout

# ── Database ─────────────────────────────────────────────
DATABASE_PATH=data/aegis_recon.db
# Path to the SQLite database file (relative to project root)

# ── Allowlist ────────────────────────────────────────────
ALLOWLIST_PATH=config/allowlist.yaml
# Path to the target allowlist file

# ── NVD API ──────────────────────────────────────────────
NVD_API_KEY=
# Optional: NVD API key for higher rate limits
# Get one free at https://nvd.nist.gov/developers/request-an-api-key
NVD_RATE_LIMIT=5
# Requests per 30-second window (6 with key, 5 without)
NVD_CACHE_TTL=86400
# Cache duration in seconds (default: 24 hours)

# ── CISA KEV ─────────────────────────────────────────────
KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known-exploited-vulnerabilities.json
KEV_CACHE_TTL=3600
# Cache duration in seconds (default: 1 hour)

# ── AI / LLM (Optional) ─────────────────────────────────
AI_ENABLED=false
AI_PROVIDER=none
# Options: gemini, anthropic, none
GEMINI_API_KEY=
# Your Gemini API Key from Google AI Studio (can be multiple comma-separated keys for auto-rotation)
GEMINI_MODEL=gemini-1.5-flash
ANTHROPIC_API_KEY=
# Required only if AI_ENABLED=true and AI_PROVIDER=anthropic
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.2

# ── API Server ───────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
# Do NOT expose to 0.0.0.0 unless behind a firewall

# ── Authentication ───────────────────────────────────────
# Leave blank to disable auth (local dev / single-user mode).
# For production, generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=
